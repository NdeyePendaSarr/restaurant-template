# Base de données PostgreSQL (Neon — https://neon.tech, offre gratuite)
# Récupère l'URL de connexion "pooled" et colle-la ici.
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Mot de passe de l'espace admin (/admin)
ADMIN_PASSWORD="change-moi"

# Secret de signature des sessions (32+ caractères aléatoires)
# Génère-en un : openssl rand -base64 32
AUTH_SECRET="mets-ici-une-longue-chaine-aleatoire-32c-min"

# Emails de confirmation (Brevo — https://brevo.com, offre gratuite 300/jour)
# Clé API : Brevo → SMTP & API → API Keys → Create a new API key
BREVO_API_KEY="xkeysib-xxxxxxxxxxxxxxxx"
# Adresse expéditeur VÉRIFIÉE dans Brevo (Senders, Domains & Dedicated IPs → Senders)
EMAIL_FROM="ton-adresse@exemple.com"
EMAIL_FROM_NAME="Teranga Table"
